              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new photo (simulated)."
        },
        {
          "info": {
            "name": "JSONPlaceholder Get Photo",
            "type": "http"
          },
          "http": {
            "method": "GET",
